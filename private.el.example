;;; private.el.example --- Example private configuration -*- lexical-binding: t -*-
;; Copy this file to private.el and customize with your private accounts,
;; SMTP servers, signatures, and bookmarks.
;;
;;   cp private.el.example private.el

;; --- Smtp config ---
(setq send-mail-function 'smtpmail-send-it
      message-send-mail-function 'smtpmail-send-it)

;; Use pass (password-store) to store passwords for e-mail
(setq auth-sources '(password-store))

(require 'gnus-dired)
(defun gnus-dired-mail-buffers ()
  "Return a list of active message buffers."
  (let (buffers)
    (save-current-buffer
      (dolist (buffer (buffer-list t))
        (set-buffer buffer)
        (when (and (derived-mode-p 'message-mode)
                   (null message-sent-message-via))
          (push (buffer-name buffer) buffers))))
    (nreverse buffers)))

(setq gnus-dired-mail-mode 'mu4e-user-agent)
(add-hook 'dired-mode-hook 'turn-on-gnus-dired-mode)

;; --- Main config of mu4e ---
(use-package mu4e
  :config
  (add-to-list 'mu4e-view-actions '("ViewInBrowser" . mu4e-action-view-in-browser) t)
  (add-to-list 'mu4e-view-actions '("Eww view"      . view-message-in-eww) t)
  (add-hook 'message-mode-hook 'turn-on-orgtbl)
  (add-hook 'message-mode-hook 'turn-on-orgstruct++)
  (setq mu4e-maildir "~/Mail"
        mu4e-get-mail-command "offlineimap"
        mu4e-update-interval 900
        mu4e-compose-format-flowed t
        mu4e-headers-date-format "%d-%m-%Y %H:%M"
        mu4e-view-show-addresses t
        message-kill-buffer-on-exit t
        mu4e-headers-include-related t
        mu4e-compose-dont-reply-to-self t
        mu4e-save-multiple-attachments-without-asking t
        smtpmail-queue-dir "~/Mail/queue/cur")

  (setq mu4e-headers-fields
        '((:human-date   . 20)
          (:flags        . 6)
          (:mailing-list . 10)
          (:from         . 22)
          (:subject)))

  ;; Example context configuration
  (setq mu4e-contexts
        `(,(make-mu4e-context
            :name "personal"
            :enter-func (lambda () (mu4e-message "Entering personal context"))
            :leave-func (lambda () (mu4e-message "Leaving personal context"))
            :match-func (lambda (msg)
                          (when msg
                            (mu4e-message-contact-field-matches msg :to "user@example.com")))
            :vars '((user-mail-address      . "user@example.com")
                    (user-full-name         . "Your Name")
                    (mu4e-sent-folder       . "/personal/Sent")
                    (mu4e-drafts-folder     . "/personal/Drafts")
                    (mu4e-trash-folder      . "/personal/Trash")
                    (mu4e-maildir-shortcuts . (("/personal/INBOX"   . ?i)
                                               ("/personal/Sent"    . ?s)
                                               ("/personal/Drafts"  . ?d)
                                               ("/personal/Trash"   . ?t)))
                    (smtpmail-smtp-server   . "smtp.example.com")
                    (smtpmail-smtp-service  . 587)
                    (smtpmail-smtp-user     . "user@example.com")
                    (smtpmail-stream-type   . starttls)
                    (mu4e-compose-signature . "Your Name\nhttps://example.com")))))

  (setq mu4e-context-policy 'pick-first
        mu4e-compose-context-policy nil))

;; Keybinding to open mu4e
(global-set-key (kbd "C-<f6>") 'mu4e)

(provide 'private)
;;; private.el.example ends here
